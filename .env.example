# Public canonical URL. Leave unset until the real domain is confirmed.
NEXT_PUBLIC_SITE_URL=
# Optional verified contact details. Empty values are hidden in the UI.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# HTTPS endpoint that accepts JSON and acknowledges durable lead receipt.
LEAD_WEBHOOK_URL=
# Optional server-only bearer token for that endpoint.
LEAD_WEBHOOK_TOKEN=
# Explicit opt-in for a loopback webhook during local automated testing only.
ALLOW_LOCAL_WEBHOOK=false
# Keep disabled until delivery, consent, policy copy and domain are verified.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Optional GA4 ID. Analytics loads only after visitor consent.
NEXT_PUBLIC_GA_ID=
